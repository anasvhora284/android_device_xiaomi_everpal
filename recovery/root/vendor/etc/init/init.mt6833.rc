on init
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.configfs 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

on fs
    install_keyring

on post-fs
    start boot-hal-1-2

on boot
    start health-hal-2-1
    start vibrator-everpal
    start fuelgauged

# Keymaster must see the installed ROM's version/patch levels before it starts (prepdecrypt-everpal.sh).
on property:hwservicemanager.ready=true
    start prepdecrypt-everpal

on property:prepdecrypt.everpal.done=1
    start teei_daemon
    start keymaster-4-1-beanpod
    start gatekeeper-1-0

service prepdecrypt-everpal /system/bin/prepdecrypt-everpal.sh
    oneshot
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# After decryption only the TEE services are stopped. servicemanager/hwservicemanager must keep
# running: update_engine_sideload reaches IBootControl through hwservicemanager (A/B ROM installs)
# and the vibrator is an AIDL service registered with servicemanager.
on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-1-beanpod
    stop gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-1-beanpod
    stop gatekeeper-1-0

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-4-1-beanpod
    stop gatekeeper-1-0

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc log
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-1-beanpod /vendor/bin/hw/android.hardware.keymaster@4.1-service.beanpod
    user root
    group root drmrpc
    oneshot
    disabled
    seclabel u:r:recovery:s0

# QTI AIDL vibrator (vibrator/), drives the awinic_haptic FF input device for TWRP's AIDL haptics
service vibrator-everpal /system/bin/vibrator-service.everpal-recovery
    user root
    group root input
    disabled
    seclabel u:r:recovery:s0

# MediaTek GM3.0 battery gauge: the kernel reports capacity only while fuelgauged runs.
# 32-bit, so it runs through the bundled 32-bit loader/libs in /system/lib (the recovery is 64-bit;
# its ld.config only covers lib64). fuelgauged_nvram is NOT shipped and nvcfg/nvdata are never
# mounted here, so libfgauge_gm30's calibration writes under /mnt/vendor/nvcfg can't reach the
# partition (verified on device: "nvcfg is not mounted", "Save old_data fail", capacity correct).
service fuelgauged /system/bin/linker /vendor/bin/fuelgauged
    setenv LD_LIBRARY_PATH /system/lib:/vendor/lib
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0
