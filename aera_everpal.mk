# 1080x2400 display with a centred punch-hole.
AERA_MAINTAINER := aetomtomy
AERA_SCREEN_H := 2400
AERA_STATUS_H := 100
AERA_STATUS_INDENT_LEFT := 48
AERA_STATUS_INDENT_RIGHT := 48
AERA_HIDE_NOTCH := 1
AERA_CLOCK_POS := 1

AERA_FLASHLIGHT_ENABLE := 1
AERA_FL_PATH1 := /system/flashlight

# Use the installed ROM's MediaTek WLAN stack on demand.
AERA_ENABLE_WLAN := 1
